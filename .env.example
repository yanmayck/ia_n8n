# ===================================================================
# CONFIGURAÇÃO DO BANCO DE DADOS
# ===================================================================
# Escolha UMA das opções abaixo e descomente a linha DATABASE_URL correspondente.

# --- Opção 1: Desenvolvimento Local com Docker (Recomendado para testes) ---
# Para usar esta opção, inicie o banco de dados com: docker-compose -f docker-compose.test.yml up -d
DATABASE_URL="postgresql://testuser:testpassword@localhost:5435/testdb"

# --- Opção 2: Conexão com Supabase (Produção) ---
# Preencha as variáveis abaixo com suas credenciais do Supabase.
# POSTGRES_USER="postgres"
# POSTGRES_PASSWORD="your_supabase_db_password"
# SUPABASE_PROJECT_REF="your_supabase_project_ref"
# POSTGRES_DB="postgres"
# E então, descomente e use a linha abaixo, substituindo os placeholders:
# DATABASE_URL="postgresql://postgres:[YOUR_PASSWORD]@[YOUR_PROJECT_REF].db.supabase.co:5432/postgres"


# ===================================================================
# CHAVES DE API E SEGURANÇA
# ===================================================================

# Chave secreta para JWT (gere uma string longa e aleatória usando: openssl rand -hex 32)
SECRET_KEY="your_super_secret_jwt_key"

# Senha para acesso à interface de administração (altere para uma senha forte)
ADMIN_PASSWORD="your_strong_admin_password"

# Chaves de API para Serviços Externos
GEMINI_API_KEY="your_gemini_api_key"
GOOGLE_MAPS_API_KEY="your_google_maps_api_key" # Essencial para o cálculo de frete

# Chave secreta para a sincronização via webhook (deve ser a mesma no .env do business-whats-dashboard)
SYNC_SECRET_KEY="um-segredo-muito-forte-e-compartilhado-123"


# ===================================================================
# CONFIGURAÇÃO DO REDIS (Para Gerenciamento de Estado da Conversa)
# ===================================================================
# Para desenvolvimento local, use 'redis' se estiver rodando o app principal via Docker Compose
# ou 'localhost' se estiver rodando o app localmente e o redis via 'docker-compose.test.yml'.
REDIS_HOST="localhost"
REDIS_PORT=6380 # Porta definida no docker-compose.test.yml
REDIS_PASSWORD=""


# ===================================================================
# OUTRAS CONFIGURAÇÕES
# ===================================================================
DEBUG=True
